              {resource.images?.[0]?.image_url && (
                resource.images[0].image_url.startsWith("/") ||
                resource.images[0].image_url.startsWith("http") ||
                resource.images[0].image_url.startsWith("data:")
              ) ? (
                <img
                  src={getImageUrl(resource.images[0].image_url)}
