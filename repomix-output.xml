<file path="frontend/src/index.css">
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

html {
  scroll-behavior: smooth;
  color-scheme: light;
}

html.dark {
  color-scheme: dark;
}

html, body {
  @apply bg-slate-50 dark:bg-slate-950 text-ink dark:text-slate-100 font-body antialiased;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  @apply font-display text-ink-900 tracking-tight;
}

::selection {
  @apply bg-primary-100 text-primary-900;
}

*:focus-visible {
  outline: 2px solid theme("colors.primary.500");
  outline-offset: 2px;
}

@layer components {
  .btn {
    @apply inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition-all duration-150 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed;
  }

  .btn-primary {
    @apply btn bg-primary-600 text-white hover:bg-primary-700 shadow-sm shadow-primary-600/10;
  }

  .btn-secondary {
    @apply btn bg-white dark:bg-slate-900 text-ink-700 dark:text-slate-300 border border-ink-200 dark:border-slate-800 hover:bg-ink-50 dark:hover:bg-slate-800 hover:text-ink-900 dark:hover:text-white;
  }

  .btn-brass {
    @apply btn bg-brass-500 text-white hover:bg-brass-700;
  }

  .input {
    @apply w-full rounded-xl border border-ink-200 dark:border-slate-800 bg-white dark:bg-slate-950 px-3.5 py-2.5 text-sm text-ink-900 dark:text-slate-100 placeholder:text-ink-400 dark:placeholder:text-slate-500 focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-all outline-none;
  }

  select {
    @apply appearance-none;
    padding-right: 2.5rem !important;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2364748B' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.75rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
  }

  .dark select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2394A3B8' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
  }

  .label {
    @apply block text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-slate-400 mb-1.5;
  }

  .card {
    @apply bg-white dark:bg-slate-900 rounded-2xl shadow-card border border-ink-200/50 dark:border-slate-800/80 hover:border-ink-200/80 dark:hover:border-slate-700/80 transition-all duration-200;
  }

  /* Signature element: library index card with a perforated ticket-stub edge,
     used for resource listings across the app. */
  .index-card {
    @apply relative card overflow-hidden;
  }

  .index-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 14px;
    background-image: radial-gradient(circle at 0 8px, transparent 5px, #fff 5px),
      radial-gradient(circle at 0 28px, transparent 5px, #fff 5px),
      radial-gradient(circle at 0 48px, transparent 5px, #fff 5px);
    background-repeat: repeat-y;
    background-size: 14px 20px;
  }
}
</file>

