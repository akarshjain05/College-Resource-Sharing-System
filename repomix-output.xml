                value={form.against_user_id}
                onChange={(e) => setForm({ ...form, against_user_id: e.target.value })}
                disabled={!!initialAgainstUserId || !!initialBorrowRequestId}
              >
                <option value="">-- None / Platform Issue --</option>
                {users.map((u) => (
                  <option key={u.id} value={u.id}>
