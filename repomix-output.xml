  }

  const sDate = selectedDateRange.start;
  const eDate = selectedDateRange.end || selectedDateRange.start;

  const daysCount = sDate && eDate
    ? Math.max(1, Math.ceil((eDate - sDate) / (1000 * 60 * 60 * 24)) + 1)
